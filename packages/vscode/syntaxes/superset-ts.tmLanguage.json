{
  "$schema": "https://raw.githubusercontent.com/martinring/tmlanguage/master/tmlanguage.json",
  "name": "Superset TS",
  "scopeName": "source.superset-ts",
  "patterns": [
    {
      "include": "#brand-type"
    },
    {
      "include": "#validate-type"
    },
    {
      "include": "#checked-cast"
    },
    {
      "include": "source.ts"
    }
  ],
  "repository": {
    "brand-type": {
      "name": "meta.brand-type.superset-ts",
      "begin": "\\b(brand)\\s+(type)\\b",
      "beginCaptures": {
        "1": {
          "name": "keyword.other.brand.superset-ts"
        },
        "2": {
          "name": "keyword.declaration.type.superset-ts"
        }
      },
      "end": "(?<=\\})\\s*;?|(?=;|$)",
      "patterns": [
        {
          "name": "entity.name.type.superset-ts",
          "match": "[A-Za-z_$][\\w$]*"
        },
        {
          "name": "keyword.other.is.superset-ts",
          "match": "\\bis\\b"
        },
        {
          "name": "keyword.operator.assignment.superset-ts",
          "match": "="
        },
        {
          "name": "keyword.operator.union.superset-ts",
          "match": "\\|"
        },
        {
          "name": "keyword.operator.intersection.superset-ts",
          "match": "&"
        },
        {
          "name": "string.quoted.double.superset-ts",
          "match": "\"(?:[^\"\\\\]|\\\\.)*\""
        },
        {
          "name": "string.quoted.single.superset-ts",
          "match": "'(?:[^'\\\\]|\\\\.)*'"
        },
        {
          "name": "punctuation.section.block.superset-ts",
          "match": "[{}]"
        }
      ]
    },
    "validate-type": {
      "name": "meta.validate-type.superset-ts",
      "begin": "\\b(validate)\\s+(type)\\b",
      "beginCaptures": {
        "1": {
          "name": "keyword.other.validate.superset-ts"
        },
        "2": {
          "name": "keyword.declaration.type.superset-ts"
        }
      },
      "end": "(?<=\\})\\s*;?|(?=;|$)",
      "patterns": [
        {
          "name": "entity.name.type.superset-ts",
          "match": "[A-Za-z_$][\\w$]*"
        },
        {
          "name": "keyword.operator.assignment.superset-ts",
          "match": "="
        },
        {
          "name": "keyword.operator.union.superset-ts",
          "match": "\\|"
        },
        {
          "name": "storage.type.primitive.superset-ts",
          "match": "\\b(?:string|number|boolean)\\b"
        },
        {
          "name": "punctuation.section.block.superset-ts",
          "match": "[{}\\[\\]?:;,]"
        }
      ]
    },
    "checked-cast": {
      "name": "keyword.operator.checked-cast.superset-ts",
      "match": "\\bcast\b"
    }
  }
}
