{
  "$schema": "https://raw.githubusercontent.com/martinring/tmlanguage/master/tmlanguage.json",
  "name": "Sound TS",
  "scopeName": "source.sound-ts",
  "patterns": [
    {
      "include": "#brand-type"
    },
    {
      "include": "#validate-type"
    },
    {
      "include": "#checked-cast"
    },
    {
      "include": "source.ts"
    }
  ],
  "repository": {
    "brand-type": {
      "name": "meta.brand-type.sound-ts",
      "begin": "\\b(brand)\\s+(type|enum)\\b",
      "beginCaptures": {
        "1": {
          "name": "keyword.control.brand.sound-ts"
        },
        "2": {
          "name": "keyword.control.type.sound-ts"
        }
      },
      "end": "(?<=\\})\\s*;?|(?=;|$)",
      "patterns": [
        {
          "name": "entity.name.type.sound-ts",
          "match": "[A-Za-z_$][\\w$]*"
        },
        {
          "name": "keyword.other.is.sound-ts",
          "match": "\\bis\\b"
        },
        {
          "name": "keyword.operator.assignment.sound-ts",
          "match": "="
        },
        {
          "name": "keyword.operator.union.sound-ts",
          "match": "\\|"
        },
        {
          "name": "keyword.operator.intersection.sound-ts",
          "match": "&"
        },
        {
          "name": "string.quoted.double.sound-ts",
          "match": "\"(?:[^\"\\\\]|\\\\.)*\""
        },
        {
          "name": "string.quoted.single.sound-ts",
          "match": "'(?:[^'\\\\]|\\\\.)*'"
        },
        {
          "name": "punctuation.section.block.sound-ts",
          "match": "[{}]"
        }
      ]
    },
    "validate-type": {
      "name": "meta.validate-type.sound-ts",
      "begin": "\\b(validate)\\s+(type)\\b",
      "beginCaptures": {
        "1": {
          "name": "keyword.control.validate.sound-ts"
        },
        "2": {
          "name": "keyword.control.type.sound-ts"
        }
      },
      "end": "(?<=\\})\\s*;?|(?=;|$)",
      "patterns": [
        {
          "name": "entity.name.type.sound-ts",
          "match": "[A-Za-z_$][\\w$]*"
        },
        {
          "name": "keyword.operator.assignment.sound-ts",
          "match": "="
        },
        {
          "name": "keyword.operator.union.sound-ts",
          "match": "\\|"
        },
        {
          "name": "storage.type.primitive.sound-ts",
          "match": "\\b(?:string|number|boolean)\\b"
        },
        {
          "name": "punctuation.section.block.sound-ts",
          "match": "[{}\\[\\]?:;,]"
        }
      ]
    },
    "checked-cast": {
      "name": "keyword.control.cast.sound-ts",
      "match": "\\bcast\\b"
    }
  }
}
