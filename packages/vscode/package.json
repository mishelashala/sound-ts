{
  "name": "sound-ts",
  "displayName": "Sound TS",
  "description": "Thin language support for the sound-ts brand type dialect. Not a TypeScript fork or custom checker.",
  "version": "0.2.0",
  "publisher": "mishelashala",
  "private": true,
  "license": "MIT",
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": ["Programming Languages"],
  "keywords": ["typescript", "brand type", "sound-ts"],
  "activationEvents": [
    "onLanguage:sound-ts",
    "onLanguage:typescript"
  ],
  "main": "./extension.js",
  "contributes": {
    "languages": [
      {
        "id": "sound-ts",
        "aliases": ["Sound TS", "sound-ts", "sts"],
        "extensions": [".sts"],
        "configuration": "./language-configuration.json"
      }
    ],
    "grammars": [
      {
        "language": "sound-ts",
        "scopeName": "source.sound-ts",
        "path": "./syntaxes/sound-ts.tmLanguage.json"
      },
      {
        "scopeName": "source.sound-ts.injection",
        "path": "./syntaxes/brand-type.injection.json",
        "injectTo": ["source.ts", "source.tsx", "source.sound-ts"]
      }
    ],
    "commands": [
      {
        "command": "sound-ts.transformFile",
        "title": "Sound TS: Transform brand type (run CLI)"
      }
    ]
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/mishelashala/sound-ts.git"
  }
}
