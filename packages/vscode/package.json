{
  "name": "superset-ts",
  "displayName": "Superset TS",
  "description": "Thin language support for the superset-ts brand type dialect. Not a TypeScript fork or custom checker.",
  "version": "0.2.0",
  "publisher": "mishelashala",
  "private": true,
  "license": "MIT",
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": ["Programming Languages"],
  "keywords": ["typescript", "brand type", "superset-ts"],
  "activationEvents": [
    "onLanguage:superset-ts",
    "onLanguage:typescript"
  ],
  "main": "./extension.js",
  "contributes": {
    "languages": [
      {
        "id": "superset-ts",
        "aliases": ["Superset TS", "superset-ts", "sts"],
        "extensions": [".sts"],
        "configuration": "./language-configuration.json"
      }
    ],
    "grammars": [
      {
        "language": "superset-ts",
        "scopeName": "source.superset-ts",
        "path": "./syntaxes/superset-ts.tmLanguage.json"
      },
      {
        "scopeName": "source.superset-ts.injection",
        "path": "./syntaxes/brand-type.injection.json",
        "injectTo": ["source.ts", "source.tsx", "source.superset-ts"]
      }
    ],
    "commands": [
      {
        "command": "superset-ts.transformFile",
        "title": "Superset TS: Transform brand type (run CLI)"
      }
    ]
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/mishelashala/superset-ts.git"
  }
}
