{
  "name": "@mishelashala/sound-ts-cli",
  "version": "0.3.2",
  "private": false,
  "description": "CLI: sts build / watch compile a Node app; sts transform expands to plain TS",
  "license": "MIT",
  "type": "module",
  "bin": {
    "sound-ts": "./dist/cli.js",
    "sts": "./dist/cli.js"
  },
  "main": "./dist/cli.js",
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "test": "vitest run",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@mishelashala/sound-ts-core": "workspace:*",
    "typescript": "^5.6.3"
  },
  "engines": {
    "node": ">=18"
  },
  "publishConfig": {
    "access": "public"
  }
}
