{
  "compilerOptions": {
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "strict": true,
    "skipLibCheck": true,
    "rootDir": ".sound-ts",
    "outDir": "dist",
    "noEmitOnError": true
  },
  "include": [".sound-ts/**/*.ts"],
  "exclude": ["**/*.sts", "src"]
}
